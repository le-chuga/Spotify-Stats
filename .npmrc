# Solo instala versiones de paquetes publicadas hace al menos 7 dias.
# Esto da tiempo a que se detecten y retiren paquetes maliciosos
# antes de que lleguen a tu maquina (recomendado por CISA tras los
# ataques de cadena de suministro a npm en 2026, p.ej. axios/node-ipc).
min-release-age=7

# Nota: NO se desactiva ignore-scripts porque sql.js necesita su
# postinstall para colocar el binario WASM. Si en el futuro cambias
# de base de datos y ya no usas sql.js, puedes anadir aqui:
#   ignore-scripts=true
# para bloquear scripts de instalacion de todas las dependencias.
