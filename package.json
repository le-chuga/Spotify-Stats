{
  "name": "frecuencia",
  "version": "1.0.0",
  "description": "Frecuencia - Spotify Stats en Cloudflare Workers",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create frecuencia-db",
    "db:migrate": "wrangler d1 execute frecuencia-db --file=schema.sql",
    "db:migrate:remote": "wrangler d1 execute frecuencia-db --remote --file=schema.sql",
    "kv:create": "wrangler kv namespace create SESSIONS",
    "check:launch": "node scripts/check-launch.mjs",
    "predeploy": "npm run check:launch && npm run check:headers",
    "sync:headers": "node scripts/sync-headers.mjs",
    "check:headers": "node scripts/sync-headers.mjs --check",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:security": "npm run check:headers && npm run check:secrets",
    "setup:hooks": "git config core.hooksPath .githooks",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "dependencies": {
    "hono": "4.13.16"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
